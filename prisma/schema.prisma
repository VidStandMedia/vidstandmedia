generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns        Campaign[]
  googleAccount    GoogleAccount?
  channelAnalytics ChannelAnalytics[]
}

model Campaign {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goal      String
  budget    String

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreement CampaignAgreement?
  audience  CampaignAudience?
  business  CampaignBusiness?
  channel   CampaignChannel?
  googleAds CampaignGoogleAds?
  payment   CampaignPayment?
  video     CampaignVideo?

  @@index([userId])
}

model CampaignChannel {
  id               String @id @default(cuid())
  campaignId       String @unique
  youtubeChannelId String
  title            String
  thumbnail        String
  email            String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignGoogleAds {
  id                    String   @id @default(cuid())
  campaignId            String   @unique
  hasAccount            Boolean?
  customerId            String
  accountName           String
  currency              String
  timeZone              String
  verified              Boolean
  managerInvitationSent Boolean
  managerAccessAccepted Boolean

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignBusiness {
  id          String @id @default(cuid())
  campaignId  String @unique
  clientType  String @default("business")
  companyName String
  website     String
  category    String
  timeZone    String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignVideo {
  id             String @id @default(cuid())
  campaignId     String @unique
  youtubeVideoId String
  title          String
  thumbnail      String
  publishedAt    String
  viewCount      Int
  duration       String
  privacyStatus  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignAudience {
  id         String   @id @default(cuid())
  campaignId String   @unique
  country    String
  language   String
  gender     String
  ageGroups  String[]
  interests  String[]

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignAgreement {
  id                    String    @id @default(cuid())
  campaignId            String    @unique
  termsAccepted         Boolean
  privacyAccepted       Boolean
  advertisingAuthorized Boolean
  acceptedAt            DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignPayment {
  id                      String    @id @default(cuid())
  campaignId              String    @unique
  managementFee           Decimal   @db.Decimal(10, 2)
  managementPlan          String
  stripeCheckoutSessionId String?
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  paymentStatus           String
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([stripeCheckoutSessionId])
}

model GoogleAccount {
  id                    String   @id @default(cuid())
  userId                String   @unique
  providerAccountId     String   @unique
  refreshTokenEncrypted String?
  scope                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerAccountId])
}

model ChannelAnalytics {
  id                         String   @id @default(cuid())
  userId                     String
  channelId                  String
  snapshotDate               DateTime @db.Date
  subscriberCount            BigInt
  viewCount                  BigInt
  videoCount                 Int
  watchTimeMinutes           Float?
  averageViewDurationSeconds Float?
  createdAt                  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, snapshotDate])
  @@index([userId, snapshotDate])
  @@index([channelId])
}
